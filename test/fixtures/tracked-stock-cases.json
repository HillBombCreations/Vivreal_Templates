{
  "about": "Checkout's tracked-stock rule, one case per row. A plain count on a product priced per option is one count shared by every option; the cart and checkout compare the sum of that product's lines with it. Kept byte identical in Vivreal_Templates and VR_Client_API; each repo runs every case against its own implementation. `lineId` is the checkout id the cart line sends (the Stripe price id, or the Square variation id). `expected.available` is the count checkout compares against, or null when the line is untracked (no cap, never refused for stock). `expected` itself is null when checkout finds no product for the line: it is unavailable and refused whatever the stock says. `option`, when present, is the option the cart line names (the size the shopper picked). It is read only for a product with one checkout id whose stock is counted per option: `expected.available` is then that option's count, the line is untracked when that count is not a number, and `expected` is null when the line names no option the stock counts. On every other product `option` changes nothing.",
  "cases": [
    { "name": "stripe single-price, plain count", "provider": "stripe", "objectValue": { "default_price": "price_one", "stock": 12 }, "lineId": "price_one", "expected": { "tracked": true, "available": 12 } },
    { "name": "stripe single-price, no stock", "provider": "stripe", "objectValue": { "default_price": "price_one" }, "lineId": "price_one", "expected": { "tracked": false, "available": null } },
    { "name": "stripe one price, counted per size, no size named is unavailable", "provider": "stripe", "objectValue": { "default_price": "price_one", "stock": { "Small": 4 } }, "lineId": "price_one", "expected": null },
    { "name": "stripe one price, counted per size, the named size's count", "provider": "stripe", "objectValue": { "default_price": "price_one", "stock": { "Small": 4, "Medium": 10 } }, "lineId": "price_one", "option": "Small", "expected": { "tracked": true, "available": 4 } },
    { "name": "stripe one price, counted per size, a sold-out size", "provider": "stripe", "objectValue": { "default_price": "price_one", "stock": { "Small": 0, "Medium": 10 } }, "lineId": "price_one", "option": "Small", "expected": { "tracked": true, "available": 0 } },
    { "name": "stripe one price, counted per size, a size the stock does not count is unavailable", "provider": "stripe", "objectValue": { "default_price": "price_one", "stock": { "Small": 4 } }, "lineId": "price_one", "option": "Large", "expected": null },
    { "name": "stripe one price, counted per size, a string count is untracked", "provider": "stripe", "objectValue": { "default_price": "price_one", "stock": { "Small": "4" } }, "lineId": "price_one", "option": "Small", "expected": { "tracked": false, "available": null } },
    { "name": "stripe one price, a plain count ignores a named option", "provider": "stripe", "objectValue": { "default_price": "price_one", "stock": 12 }, "lineId": "price_one", "option": "Small", "expected": { "tracked": true, "available": 12 } },
    { "name": "stripe single-price, a string count is untracked", "provider": "stripe", "objectValue": { "default_price": "price_one", "stock": "4" }, "lineId": "price_one", "expected": { "tracked": false, "available": null } },
    { "name": "stripe single-price, sold out", "provider": "stripe", "objectValue": { "default_price": "price_one", "stock": 0 }, "lineId": "price_one", "expected": { "tracked": true, "available": 0 } },
    { "name": "stripe sized, the chosen size's count", "provider": "stripe", "objectValue": { "default_price": { "Small": "price_small", "Large": "price_large" }, "stock": { "Small": 4 } }, "lineId": "price_small", "expected": { "tracked": true, "available": 4 } },
    { "name": "stripe sized, a size with no count never borrows another's", "provider": "stripe", "objectValue": { "default_price": { "Small": "price_small", "Large": "price_large" }, "stock": { "Small": 4 } }, "lineId": "price_large", "expected": { "tracked": false, "available": null } },
    { "name": "stripe sized, a plain count is one shared count", "provider": "stripe", "objectValue": { "default_price": { "Small": "price_small", "Large": "price_large" }, "stock": 12 }, "lineId": "price_small", "expected": { "tracked": true, "available": 12 } },
    { "name": "stripe sized, the shared count for another size", "provider": "stripe", "objectValue": { "default_price": { "Small": "price_small", "Large": "price_large" }, "stock": 12 }, "lineId": "price_large", "expected": { "tracked": true, "available": 12 } },
    { "name": "stripe sized, sold-out size", "provider": "stripe", "objectValue": { "default_price": { "Small": "price_small", "Large": "price_large" }, "stock": { "Small": 0, "Large": 2 } }, "lineId": "price_small", "expected": { "tracked": true, "available": 0 } },
    { "name": "stripe sized, an id the map does not hold is unavailable", "provider": "stripe", "objectValue": { "default_price": { "Small": "price_small" }, "stock": 5 }, "lineId": "price_other", "expected": null },
    { "name": "stripe sized, an array stock is untracked", "provider": "stripe", "objectValue": { "default_price": { "Small": "price_small" }, "stock": [4] }, "lineId": "price_small", "expected": { "tracked": false, "available": null } },
    { "name": "stripe sized, a named option never overrides the price's own", "provider": "stripe", "objectValue": { "default_price": { "Small": "price_small", "Large": "price_large" }, "stock": { "Small": 4, "Large": 1 } }, "lineId": "price_small", "option": "Large", "expected": { "tracked": true, "available": 4 } },
    { "name": "square single-price, plain count", "provider": "square", "objectValue": { "variationId": "sq_one", "price": "$5.00", "stock": 5 }, "lineId": "sq_one", "expected": { "tracked": true, "available": 5 } },
    { "name": "square single-price, sold out", "provider": "square", "objectValue": { "variationId": "sq_one", "price": "$5.00", "stock": 0 }, "lineId": "sq_one", "expected": { "tracked": true, "available": 0 } },
    { "name": "square single-price, no stock", "provider": "square", "objectValue": { "variationId": "sq_one", "price": "$5.00" }, "lineId": "sq_one", "expected": { "tracked": false, "available": null } },
    { "name": "square one price, counted per size, the named size's count", "provider": "square", "objectValue": { "variationId": "sq_one", "price": "$5.00", "stock": { "Small": 2, "Large": 3 } }, "lineId": "sq_one", "option": "Large", "expected": { "tracked": true, "available": 3 } },
    { "name": "square one price, counted per size, no size named is unavailable", "provider": "square", "objectValue": { "variationId": "sq_one", "price": "$5.00", "stock": { "Small": 2, "Large": 3 } }, "lineId": "sq_one", "expected": null },
    { "name": "square one price, counted per size, a size the stock does not count is unavailable", "provider": "square", "objectValue": { "variationId": "sq_one", "price": "$5.00", "stock": { "Small": 2, "Large": 3 } }, "lineId": "sq_one", "option": "Medium", "expected": null },
    { "name": "square sized, the line's variation's count", "provider": "square", "objectValue": { "variationId": "sq_s", "price": { "Small": "$4.50", "Large": "$6.75" }, "squareVariations": [{ "name": "Small", "variationId": "sq_s" }, { "name": "Large", "variationId": "sq_l" }], "stock": { "Large": 3 } }, "lineId": "sq_l", "expected": { "tracked": true, "available": 3 } },
    { "name": "square sized, a named option never overrides the variation's own", "provider": "square", "objectValue": { "variationId": "sq_s", "price": { "Small": "$4.50", "Large": "$6.75" }, "squareVariations": [{ "name": "Small", "variationId": "sq_s" }, { "name": "Large", "variationId": "sq_l" }], "stock": { "Small": 1, "Large": 3 } }, "lineId": "sq_l", "option": "Small", "expected": { "tracked": true, "available": 3 } },
    { "name": "square sized, a plain count is one shared count", "provider": "square", "objectValue": { "variationId": "sq_s", "price": { "Small": "$4.50", "Large": "$6.75" }, "squareVariations": [{ "name": "Small", "variationId": "sq_s" }, { "name": "Large", "variationId": "sq_l" }], "stock": 0 }, "lineId": "sq_s", "expected": { "tracked": true, "available": 0 } },
    { "name": "square sized, a size with no count is untracked", "provider": "square", "objectValue": { "variationId": "sq_s", "price": { "Small": "$4.50", "Large": "$6.75" }, "squareVariations": [{ "name": "Small", "variationId": "sq_s" }, { "name": "Large", "variationId": "sq_l" }], "stock": { "Small": 2 } }, "lineId": "sq_l", "expected": { "tracked": false, "available": null } },
    { "name": "square sized, no squareVariations stored falls to the plain count", "provider": "square", "objectValue": { "variationId": "sq_s", "price": { "Small": "$4.50", "Large": "$6.75" }, "stock": 7 }, "lineId": "sq_s", "expected": { "tracked": true, "available": 7 } },
    { "name": "square sized, an id no variation holds is unavailable", "provider": "square", "objectValue": { "variationId": "sq_s", "price": { "Small": "$4.50", "Large": "$6.75" }, "squareVariations": [{ "name": "Small", "variationId": "sq_s" }, { "name": "Large", "variationId": "sq_l" }], "stock": { "Large": 3 } }, "lineId": "sq_other", "expected": null },
    { "name": "square sized, a variation name the price map lacks falls to the plain count", "provider": "square", "objectValue": { "variationId": "sq_s", "price": { "Small": "$4.50" }, "squareVariations": [{ "name": "Large", "variationId": "sq_l" }], "stock": { "Large": 3 } }, "lineId": "sq_l", "expected": { "tracked": false, "available": null } }
  ]
}
